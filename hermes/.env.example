# Luca — Environment Variables
# Copy this to ~/.hermes/.env and fill in your values
# Never commit .env to git

# Bankr Agent API (LLM layer)
BANKR_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Alchemy (Base blockchain data)
ALCHEMY_API_KEY=

# OPTIONAL: pre-load wallets on boot (comma-separated)
# You can also just tell Luca a wallet address in conversation
# and he will start watching it from there — no config needed
# OPERATOR_WALLETS=0x...,0x...

# Materiality threshold in USD (default 50)
MATERIALITY_USD=50

# Reporting timezone
TIMEZONE=UTC
