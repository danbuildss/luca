{
  "name": "luca",
  "version": "0.1.0",
  "description": "Private financial agent for on-chain operators",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker \"npm run api:dev\" \"npm run worker:dev\"",
    "worker:dev": "tsx watch apps/worker/index.ts",
    "api:dev": "tsx watch apps/api/index.ts",
    "api:start": "node dist/apps/api/index.js",
    "worker:start": "node dist/apps/worker/index.js",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:up": "docker compose up -d postgres-test",
    "db:test:down": "docker compose down -v",
    "db:test:migrate": "tsx scripts/migrate.ts --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "fastify": "^4.26.2",
    "pg": "^8.11.3",
    "pino": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
