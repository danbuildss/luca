{
  "name": "luca",
  "version": "0.1.0",
  "description": "Private financial agent for on-chain operators",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run worker:dev\" \"npm run bot:dev\" \"npm run api:dev\"",
    "worker:dev": "tsx watch apps/worker/index.ts",
    "bot:dev": "tsx watch apps/telegram/index.ts",
    "api:dev": "tsx watch apps/api/index.ts",
    "build": "tsc",
    "start:worker": "node dist/apps/worker/index.js",
    "start:bot": "node dist/apps/telegram/index.js",
    "start:api": "node dist/apps/api/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "backfill": "tsx scripts/backfill.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.17.1",
    "axios": "^1.6.7",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.2",
    "node-cron": "^3.0.3",
    "openai": "^4.28.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "pg": "^8.11.3",
    "pino": "^8.18.0",
    "telegraf": "^4.16.3",
    "viem": "^2.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-v8": "^1.3.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
