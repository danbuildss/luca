[Unit]
Description=Luca Telegram Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=luca
Group=luca
WorkingDirectory=/opt/luca
EnvironmentFile=/opt/luca/.env
ExecStart=/usr/bin/node dist/apps/telegram/index.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=luca-telegram

# Graceful shutdown — bot handles SIGTERM/SIGINT
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
