# Luca — Environment Variables

# Database
DATABASE_URL=postgresql://postgres:luca@localhost:5432/luca

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Alchemy (Base RPC + Transfers API)
ALCHEMY_API_KEY=your_alchemy_api_key_here
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# LLM (pick one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Basescan (for tx deep links)
BASESCAN_API_KEY=your_basescan_api_key_here

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Optional: Redis (for job queue)
# REDIS_URL=redis://localhost:6379

# Optional: Backup RPC
# QUICKNODE_BASE_RPC=your_quicknode_rpc_here
