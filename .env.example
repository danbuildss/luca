# =============================================================================
# Luca — environment variables
# Copy this file to .env and fill in every value before starting.
# NEVER commit .env to git.
# =============================================================================

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://luca:CHANGE_ME_DB_PASSWORD@localhost:5432/luca

# --- Telegram ---
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# --- Blockchain data ---
# Alchemy API key — create a project at dashboard.alchemy.com
ALCHEMY_API_KEY=
# Base mainnet RPC (can use Alchemy's endpoint)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- LLM (classification engine) ---
# OpenAI — gpt-4o-mini classifies your transactions. Get a key at platform.openai.com
OPENAI_API_KEY=

# --- Bankr Wallet API (read-only portfolio enrichment) ---
# Sign up at bankr.bot/api-keys — enable Wallet API only
# Leave blank to disable Bankr integration
BANKR_API_KEY=

# --- Optional enrichment ---
# Basescan API key — improves gas USD pricing on Base
# BASESCAN_API_KEY=

# --- App settings ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# LLM circuit breaker — halt LLM calls if daily spend exceeds this amount (USD)
LLM_DAILY_SPEND_CAP_USD=1.00
