# =============================================================================
# Luca — environment variables
# Copy this file to .env and fill in every value before starting.
# NEVER commit .env to git.
# =============================================================================

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://luca:CHANGE_ME_DB_PASSWORD@localhost:5432/luca

# --- Telegram ---
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# --- Blockchain data ---
# Alchemy API key — create a project at dashboard.alchemy.com
ALCHEMY_API_KEY=
# Base mainnet RPC (can use Alchemy's endpoint)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- LLM (agent and classification) ---
# One provider for both the chat agent and the transaction classifier.
# Either an OpenAI key (platform.openai.com): the classifier uses gpt-4o-mini.
OPENAI_API_KEY=
# Or any OpenAI-compatible gateway, which takes precedence when set.
# Example: Bankr LLM Gateway (bankr.bot/api-keys — enable LLM Gateway only: Luca is
# read-only and must never hold a key that can act on a wallet)
AGENT_LLM_KEY=
AGENT_BASE_URL=https://llm.bankr.bot/v1
AGENT_MODEL=gpt-5.4-mini
# Classifier model. Default: AGENT_MODEL on a gateway, gpt-4o-mini on OpenAI.
# CLASSIFIER_MODEL=

# --- Prices (CoinGecko) ---
# Works without a key at a low rate limit. A free Demo key (coingecko.com/en/api)
# raises it; set the tier to "pro" only for a paid Pro key.
# COINGECKO_API_KEY=
# COINGECKO_API_TIER=demo

# --- Optional enrichment ---
# Basescan API key — improves gas USD pricing on Base
# BASESCAN_API_KEY=

# --- App settings ---
NODE_ENV=production
PORT=3000
# API bind address. Keep 127.0.0.1 — the API trusts the x-user-id header and
# must only be reachable from this host (nginx connects via loopback).
API_HOST=127.0.0.1
LOG_LEVEL=info

# LLM circuit breaker — halt LLM calls if daily spend exceeds this amount (USD)
LLM_DAILY_SPEND_CAP_USD=1.00
